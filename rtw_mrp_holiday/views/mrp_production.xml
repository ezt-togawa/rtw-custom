<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mrp_production_form_view_holiday_warning" model="ir.ui.view">
            <field name="name">mrp.production.form.holiday.warning</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_planned_start']" position="after">
                    <field name="is_planned_start_holiday" invisible="1"/>
                    <span class="badge badge-warning o_rtw_holiday_badge" title="休日です" attrs="{'invisible': [('is_planned_start_holiday', '=', False)]}">休</span>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
